          "cssClass": "",
          "role": 0,
          "editRole": 0,
          "permission": 0,
          "tooltip": "",
          "visibilityFormula": "",
          "editableFormula": "",
          "escapeHTML": false,
          "type": "label",
          "size": "full-size",
          "icon": "star",
          "value": "${actionLabel ? actionLabel : \"Cast\"}$\n",
          "prefix": "",
          "suffix": "",
          "rollMessage": "(() => {\n  const mod = game.modules.get(\"sinlesscsb\");\n  const api = mod?.api;\n  if (!api?.castSpell) {\n    return ui.notifications?.warn(\"SinlessCSB API missing: game.modules.get('sinlesscsb').api.castSpell\");\n  }\n\n  // In an itemContainer row: linkedEntity is the item.\n  // On an item sheet: entity is the item.\n  const item = linkedEntity ?? entity;\n  const itemUuid = item?.uuid;\n  if (!itemUuid) return ui.notifications?.warn(\"No item context found (linkedEntity/entity missing).\");\n\n  // Prefer the item’s embedded parent actor, else selected token / user character.\n  const actor =\n    (item?.parent?.documentName === \"Actor\" ? item.parent : null) ??\n    canvas?.tokens?.controlled?.[0]?.actor ??\n    game.user.character ??\n    null;\n\n  const actorUuid = actor?.uuid ?? null;\n  if (!actorUuid) return ui.notifications?.warn(\"No actor found (select a token or set User Character).\");\n\n  return api.castSpell({ actorUuid, itemUuid });\n})()\n\n",
          "altRollMessage": "",
          "rollMessageToChat": false,
          "altRollMessageToChat": true,
          "style": "label"
        }
