          "icon": "",
          "value": "${actionLabel ? actionLabel : \"Use\"}$\n",
          "prefix": "",
          "suffix": "",
          "rollMessage": "%{ const api = game.modules?.get(\"sinlesscsb\")?.api; if (api?.castSpell) api.castSpell({ itemUuid: item.uuid }); else game.macros.getName(\"Sinless Cast Spell\")?.execute({ itemUuid: item.uuid }); }%\n",
